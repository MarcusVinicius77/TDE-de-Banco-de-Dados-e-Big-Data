# TRANSACAO com COMMIT / ROLLBACK via Python - igual Item 11 do script do colega
@app.route('/pedidos', methods=['POST'])
def criar_pedido_com_transacao():
    dados = request.json
    db = conectar()
    try:
        cursor = db.cursor()
        db.start_transaction()
        cursor.execute('INSERT INTO Pedidos (id_cliente, id_restaurante, status) VALUES (%s, %s, %s)', (dados['id_cliente'], dados['id_restaurante'], 'Preparando'))
        id_novo = cursor.lastrowid
        for item in dados['itens']:
            cursor.execute('INSERT INTO Itens_Pedido (id_pedido, id_produto, quantidade) VALUES (%s, %s, %s)', (id_novo, item['id_produto'], item['quantidade']))
        db.commit()
        cursor.close(); db.close()
        return jsonify({'msg': 'Pedido criado com COMMIT', 'id_pedido': id_novo})
    except Exception as e:
        db.rollback()
        db.close()
        return jsonify({'msg': 'Erro, ROLLBACK executado', 'erro': str(e)}), 500

# Consulta avancada Item 5.1 do colega - produtos mais vendidos
@app.route('/relatorio/mais-vendidos')
def mais_vendidos():
    db = conectar(); cursor = db.cursor(dictionary=True)
    cursor.execute('SELECT prod.nome_produto, SUM(ip.quantidade) AS total_vendido FROM Itens_Pedido ip INNER JOIN Produtos prod ON ip.id_produto = prod.id_produto GROUP BY prod.id_produto, prod.nome_produto ORDER BY total_vendido DESC')
    dados = cursor.fetchall(); cursor.close(); db.close()
    return jsonify(dados)

