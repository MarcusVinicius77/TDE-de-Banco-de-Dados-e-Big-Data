# TRIGGER trg_historico_pedidos - quando muda status, trigger grava em Historico_Pedidos
@app.route('/pedidos/<int:id_pedido>/status', methods=['PUT'])
def atualizar_status(id_pedido):
    novo_status = request.json.get('status')
    db = conectar(); cursor = db.cursor()
    cursor.execute('UPDATE Pedidos SET status = %s WHERE id_pedido = %s', (novo_status, id_pedido))
    db.commit(); cursor.close(); db.close()
    return jsonify({'msg': f'Status atualizado para {novo_status}. Trigger gravou no historico!'})

