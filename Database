CREATE DATABASE db_delivery_local;

USE db_delivery_local;

-- ================================================================
-- ITEM 1: CRIACAO DAS TABELAS 
-- ================================================================

CREATE TABLE Clientes (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    telefone VARCHAR(20),
    bairro VARCHAR(50),
    endereco TEXT
) ENGINE=InnoDB;

CREATE TABLE Restaurantes (
    id_restaurante INT AUTO_INCREMENT PRIMARY KEY,
    nome_restaurante VARCHAR(100) NOT NULL,
    tipo_comida VARCHAR(50),
    taxa_entrega DECIMAL(5,2) NOT NULL DEFAULT 0.00
) ENGINE=InnoDB;

CREATE TABLE Produtos (
    id_produto INT AUTO_INCREMENT PRIMARY KEY,
    nome_produto VARCHAR(100) NOT NULL,
    preco DECIMAL(6,2) NOT NULL,
    id_restaurante INT NOT NULL,
    CONSTRAINT fk_produtos_restaurantes
        FOREIGN KEY (id_restaurante)
        REFERENCES Restaurantes(id_restaurante)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;

CREATE TABLE Pedidos (
    id_pedido INT AUTO_INCREMENT PRIMARY KEY,
    id_cliente INT NOT NULL,
    id_restaurante INT NOT NULL,
    data_pedido DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(20) NOT NULL DEFAULT 'Preparando',
    CONSTRAINT fk_pedidos_clientes
        FOREIGN KEY (id_cliente)
        REFERENCES Clientes(id_cliente)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT fk_pedidos_restaurantes
        FOREIGN KEY (id_restaurante)
        REFERENCES Restaurantes(id_restaurante)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;

CREATE TABLE Itens_Pedido (
    id_item INT AUTO_INCREMENT PRIMARY KEY,
    id_pedido INT NOT NULL,
    id_produto INT NOT NULL,
    quantidade INT NOT NULL,
    CONSTRAINT fk_itens_pedidos
        FOREIGN KEY (id_pedido)
        REFERENCES Pedidos(id_pedido)
        ON DELETE CASCADE
        ON UPDATE CASCADE,
    CONSTRAINT fk_itens_produtos
        FOREIGN KEY (id_produto)
        REFERENCES Produtos(id_produto)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;

-- ================================================================
-- ITEM 2: RESTRICOES DE INTEGRIDADE
-- ================================================================

ALTER TABLE Produtos
    ADD CONSTRAINT chk_produtos_preco CHECK (preco > 0);

ALTER TABLE Restaurantes
    ADD CONSTRAINT chk_restaurantes_taxa CHECK (taxa_entrega >= 0);

ALTER TABLE Itens_Pedido
    ADD CONSTRAINT chk_itens_quantidade CHECK (quantidade > 0);

ALTER TABLE Pedidos
    ADD CONSTRAINT chk_pedidos_status
    CHECK (status IN (
        'Preparando',
        'Saiu para entrega',
        'Entregue',
        'Cancelado'
    ));

