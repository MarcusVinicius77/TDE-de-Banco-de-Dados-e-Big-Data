-- ================================================================
-- ITEM 4: CONSULTAS INICIAIS COM JOIN 
-- ================================================================

SELECT
    p.id_pedido,
    c.nome AS Cliente,
    r.nome_restaurante AS Restaurante,
    p.status
FROM Pedidos p
INNER JOIN Clientes c ON p.id_cliente = c.id_cliente
INNER JOIN Restaurantes r ON p.id_restaurante = r.id_restaurante;

SELECT
    cli.nome AS Cliente,
    rest.nome_restaurante AS Restaurante,
    prod.nome_produto AS Produto,
    ip.quantidade,
    prod.preco,
    (ip.quantidade * prod.preco) AS Total_Item
FROM Pedidos ped
JOIN Clientes cli ON ped.id_cliente = cli.id_cliente
JOIN Restaurantes rest ON ped.id_restaurante = rest.id_restaurante
JOIN Itens_Pedido ip ON ped.id_pedido = ip.id_pedido
JOIN Produtos prod ON ip.id_produto = prod.id_produto
ORDER BY ped.id_pedido;

-- ================================================================
-- ITEM 5: CONSULTAS AVANCADAS
-- ================================================================

-- 5.1 Produtos mais vendidos
SELECT
    prod.nome_produto,
    SUM(ip.quantidade) AS total_vendido
FROM Itens_Pedido ip
INNER JOIN Produtos prod ON ip.id_produto = prod.id_produto
GROUP BY prod.id_produto, prod.nome_produto
ORDER BY total_vendido DESC;

-- 5.2 Clientes que mais realizaram pedidos
SELECT
    c.nome,
    COUNT(p.id_pedido) AS total_pedidos
FROM Clientes c
INNER JOIN Pedidos p ON c.id_cliente = p.id_cliente
GROUP BY c.id_cliente, c.nome
ORDER BY total_pedidos DESC;

-- 5.3 Valor dos produtos por pedido (nao inclui taxa de entrega)
SELECT
    p.id_pedido,
    c.nome AS cliente,
    SUM(ip.quantidade * prod.preco) AS valor_produtos
FROM Pedidos p
INNER JOIN Clientes c ON p.id_cliente = c.id_cliente
INNER JOIN Itens_Pedido ip ON p.id_pedido = ip.id_pedido
INNER JOIN Produtos prod ON ip.id_produto = prod.id_produto
GROUP BY p.id_pedido, c.nome
ORDER BY p.id_pedido;

-- 5.4 Quantidade de pedidos por status
SELECT status, COUNT(*) AS quantidade_pedidos
FROM Pedidos
GROUP BY status;

-- 5.5 Clientes que ainda nao realizaram pedidos
SELECT c.id_cliente, c.nome
FROM Clientes c
LEFT JOIN Pedidos p ON p.id_cliente = c.id_cliente
WHERE p.id_pedido IS NULL;

