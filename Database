-- ================================================================
-- ITEM 8: TABELA DE HISTORICO E TRIGGER
-- ================================================================

CREATE TABLE Historico_Pedidos (
    id_historico INT AUTO_INCREMENT PRIMARY KEY,
    id_pedido INT NOT NULL,
    status_anterior VARCHAR(20),
    novo_status VARCHAR(20),
    data_alteracao DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT fk_historico_pedido
        FOREIGN KEY (id_pedido)
        REFERENCES Pedidos(id_pedido)
        ON DELETE CASCADE
        ON UPDATE CASCADE
) ENGINE=InnoDB;

DELIMITER //

CREATE TRIGGER trg_historico_pedidos
AFTER UPDATE ON Pedidos
FOR EACH ROW
BEGIN
    IF NOT (OLD.status <=> NEW.status) THEN
        INSERT INTO Historico_Pedidos (
            id_pedido,
            status_anterior,
            novo_status
        )
        VALUES (
            OLD.id_pedido,
            OLD.status,
            NEW.status
        );
    END IF;
END //

DELIMITER ;

-- Teste do Trigger: altera o status do pedido 3.
-- O Trigger registra automaticamente a mudanca no historico.
UPDATE Pedidos
SET status = 'Saiu para entrega'
WHERE id_pedido = 3;

SELECT * FROM Historico_Pedidos;

-- ================================================================
-- ITEM 9: STORED PROCEDURE
-- ================================================================

DELIMITER //

CREATE PROCEDURE consultar_pedidos_cliente(
    IN p_id_cliente INT
)
BEGIN
    SELECT
        p.id_pedido,
        c.nome AS cliente,
        r.nome_restaurante AS restaurante,
        p.data_pedido,
        p.status
    FROM Pedidos p
    INNER JOIN Clientes c ON p.id_cliente = c.id_cliente
    INNER JOIN Restaurantes r ON p.id_restaurante = r.id_restaurante
    WHERE p.id_cliente = p_id_cliente
    ORDER BY p.data_pedido DESC;
END //

DELIMITER ;

-- Teste da procedure
CALL consultar_pedidos_cliente(1);

-- ================================================================
-- ITEM 10: FUNCTION
-- ================================================================

DELIMITER //

CREATE FUNCTION calcular_total_pedido(
    p_id_pedido INT
)
RETURNS DECIMAL(10,2)
READS SQL DATA
BEGIN
    DECLARE v_total DECIMAL(10,2);

    SELECT COALESCE(SUM(ip.quantidade * prod.preco), 0.00)
    INTO v_total
    FROM Itens_Pedido ip
    INNER JOIN Produtos prod ON ip.id_produto = prod.id_produto
    WHERE ip.id_pedido = p_id_pedido;

    RETURN v_total;
END //

DELIMITER ;

-- Teste da function
SELECT
    id_pedido,
    calcular_total_pedido(id_pedido) AS valor_total_produtos
FROM Pedidos
ORDER BY id_pedido;

-- ================================================================
-- ITEM 11: TRANSACOES
-- ================================================================

-- 11.1 Exemplo de transacao confirmada (COMMIT).
-- Registra um novo pedido e seus itens na mesma transacao.

START TRANSACTION;

INSERT INTO Pedidos (id_cliente, id_restaurante, status)
VALUES (1, 1, 'Preparando');

SET @novo_pedido = LAST_INSERT_ID();

INSERT INTO Itens_Pedido (id_pedido, id_produto, quantidade)
VALUES
(@novo_pedido, 1, 1),
(@novo_pedido, 2, 1);

COMMIT;

-- Conferir o pedido criado
SELECT *
FROM Pedidos
WHERE id_pedido = @novo_pedido;

SELECT *
FROM Itens_Pedido
WHERE id_pedido = @novo_pedido;

-- 11.2 Exemplo de transacao desfeita (ROLLBACK).
-- A insercao abaixo e valida, mas sera desfeita pelo ROLLBACK.

START TRANSACTION;

INSERT INTO Pedidos (id_cliente, id_restaurante, status)
VALUES (2, 1, 'Preparando');

SET @pedido_cancelado_teste = LAST_INSERT_ID();

ROLLBACK;

-- O SELECT abaixo nao deve retornar o pedido desfeito.
SELECT *
FROM Pedidos
WHERE id_pedido = @pedido_cancelado_teste;


